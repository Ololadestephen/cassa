# Cassa runtime. MOCK_MODE=true uses the local paper ledger (same schemas as
# live) priced at live public market data. MOCK_MODE=false requires
# BINANCE_API_KEY + BINANCE_API_SECRET and fails closed without them.
MOCK_MODE=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_SUBACCOUNT_ID=
# Optional free-text parser (Groq). Off by default; the rules router always works.
# When on with a key, Groq maps phrasing to intents only — policy still decides.
LLM_PARSER=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Guardrails enforced in backend/policy.py (x402 ceiling is fixed at $20/day)
CASSA_MAX_PER_PAY_USDC=500
CASSA_MAX_DAILY_USDC=2000
CASSA_REQUIRE_CONFIRM_OVER_USDC=200
CASSA_MINIMUM_RESERVE_USDC=50
PORT=8000
FRONTEND_URL=http://localhost:3000
# Optional local state path. Defaults to backend/data/cassa.db.
# CASSA_DB_PATH=/absolute/path/to/cassa.db
